apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .project_name }}-{{ .name }}
  annotations:
    kubernetes.io/ingress.class: nginx
    {{- if .proxy_body_size }}
    nginx.ingress.kubernetes.io/proxy-body-size: "{{ .proxy_body_size }}"
    {{- end }}
spec:
  rules:
  - host: {{ .domain }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: {{ .project_name }}-{{ .name }}
            port:
              number: 80
  tls:
  - hosts:
      - {{ .domain }}
    secretName: {{ .project_name }}-{{ .name }}

---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ .project_name }}-{{ .name }}
spec:
  commonName: {{ .domain }}
  dnsNames:
  - {{ .domain }}
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt
  secretName: {{ .project_name }}-{{ .name }}

---
